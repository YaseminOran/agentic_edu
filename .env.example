# Ortam değişkenleri şablonu (Hafta 1).
# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env asla commit edilmez.

# --- Bulut model (Claude) ---
ANTHROPIC_API_KEY=
# Günlük işler için model. Maliyet önemliyse claude-haiku-5-5 de kullanılabilir.
CLAUDE_MODEL=claude-sonnet-5-5
# Zor görevler (planlama, değerlendirme hakemi) için güçlü model.
CLAUDE_MODEL_GUCLU=claude-opus-5-5

# --- Yerel model (Ollama) ---
# Mac: Ollama host'ta çalışır          -> http://host.docker.internal:11434
# Windows/Linux (ollama konteyneri)    -> http://ollama:11434
# Dev container dışında, doğrudan host'ta çalıştırıyorsanız -> http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b

# --- Embedding (Hafta 3'te kullanılır, Ollama üzerinden) ---
EMBED_MODEL=nomic-embed-text

# --- Mock API (FastAPI sahte banka servisleri) ---
MOCK_API_URL=http://localhost:8000

# --- docker-compose profili ---
# Windows/Linux: ollama konteynerinin de başlaması için "ollama" yazın.
# Mac: boş bırakın (Ollama host'ta çalışır).
COMPOSE_PROFILES=
