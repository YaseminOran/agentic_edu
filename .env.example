# Ortam değişkenleri şablonu (Hafta 1).
# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env asla commit edilmez.

# --- Bulut model (Claude) ---
ANTHROPIC_API_KEY=
# Günlük işler için model. Maliyet önemliyse claude-haiku-5-5 de kullanılabilir.
CLAUDE_MODEL=claude-sonnet-5-5
# Zor görevler (planlama, değerlendirme hakemi) için güçlü model.
CLAUDE_MODEL_GUCLU=claude-opus-5-5

# --- Yerel model (Ollama) ---
# Mac: Ollama host'ta çalışır          -> http://host.docker.internal:11434
# Windows/Linux (ollama konteyneri)    -> http://ollama:11434
# Dev container dışında, doğrudan host'ta çalıştırıyorsanız -> http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b

# --- Embedding (Hafta 3: prosedür araması, Ollama üzerinden) ---
# Türkçe dahil çok dilli model. Derse gelmeden önce: ollama pull bge-m3 (yaklaşık 1,2 GB)
# Değiştirirseniz indeksi yeniden kurun: python -m asistan.rag.indeksle
EMBED_MODEL=bge-m3

# --- İzleme (Hafta 3) ---
# jsonl: her cevapla() çalıştırmasının izi logs/izler/ altına maskelenmiş JSONL olarak yazılır
# kapali: iz yazılmaz
TRACING=jsonl

# --- Mock API (FastAPI sahte banka servisleri) ---
MOCK_API_URL=http://localhost:8000
# Hafta 2: her isteğin rastgele 503 dönme olasılığı (yeniden deneme dersini göstermek için).
# 0 yaparsanız mock API hiç hata vermez (deterministik deneme).
MOCK_HATA_ORANI=0.05

# --- docker-compose profili ---
# Windows/Linux: ollama konteynerinin de başlaması için "ollama" yazın.
# Mac: boş bırakın (Ollama host'ta çalışır).
COMPOSE_PROFILES=
